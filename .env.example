# ===================================================
# RENALDO.AI - ENVIRONMENT CONFIGURATION
# ===================================================
# Copy this file to .env.local for local development.
# On Vercel, set these variables in the Project Settings > Environment Variables.

# --- OPENROUTER RAG COPILOT CONFIGURATION ---
# Sign up at https://openrouter.ai and generate an API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default / Recommended Model setting:
# - openrouter/free (Auto-routes across best free models available)
# - meta-llama/llama-3.3-70b-instruct (Top tier reasoning, fast, excellent multilingual)
DEFAULT_MODEL=openrouter/free
OPENROUTER_MODEL=openrouter/free

# --- GOOGLE CALENDAR API (OPTIONAL / EXECUTIVE SCHEDULER) ---
# GOOGLE_CLIENT_EMAIL=xxx@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com
